{
  "name": "terrania",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp test && vp run -r build",
    "dev": "vp run --filter './apps/*' dev",
    "dev:website": "vp run website#dev",
    "dev:server": "vp run server#dev",
    "db:generate": "pnpm --dir packages/db exec drizzle-kit generate",
    "db:migrate": "pnpm --dir packages/db exec drizzle-kit migrate",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
